# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Shopify — server-side only (never expose to client)
#
# Multi-store: SHOPIFY_STORES is a JSON array, one object per shop. Each store
# has its OWN OAuth app (clientId + clientSecret). Example (single line):
#   SHOPIFY_STORES=[{"id":"main","name":"Main","storeDomain":"x.myshopify.com","apiVersion":"2025-10","clientId":"...","clientSecret":"...","isDefault":true,"specMetafields":{"Standard":{"wrap":"gid://shopify/Metaobject/123","wrapless":"gid://shopify/Metaobject/124"},"Premium":{...},"Pro":{...}}}]
#
# specMetafields holds the cue_spec_variants metaobject GIDs for THAT shop.
# Metaobjects are not portable across shops, so each store needs its own GIDs.
# Leave specMetafields out (or partial) for a store that hasn't created the
# metaobjects yet — the deploy then skips the cue_spec_variants metafield for
# the missing version/wrap combos instead of failing with a 422.
# SHOPIFY_STORES=[...]
#
# Legacy single-store fallback (used only when SHOPIFY_STORES is unset):
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# YesScale AI (OpenAI-compatible, for product content generation)
YESCALE_API_TOKEN=your_yescale_token
YESCALE_MODEL=gpt-4o-mini
# Optional: comma-separated API hosts tried in order (first reachable wins).
# Defaults to "api.yescale.vip,api.yescale.io" if unset. Override to switch
# endpoints without a code change, e.g. YESCALE_API_HOSTS=api.yescale.io
# YESCALE_API_HOSTS=api.yescale.vip,api.yescale.io

# ─────────────────────────────────────────────────────────────────────────────
# Server-side rendering on a rented GPU
# ─────────────────────────────────────────────────────────────────────────────
# Mockup images and studio videos used to render in the operator's browser, so
# picking several products froze the tab. They now render on a rented GPU:
# this app only queues a render_jobs row and pokes a serverless GPU endpoint,
# which opens /render-worker in a headless Chrome and does the work.
# See render-worker/README.md.
#
# Shared secret between this app and the worker container. Required for ANY
# server rendering — the worker API fails closed (503) without it.
# Generate with:  openssl rand -hex 32
# NEVER prefix this with NEXT_PUBLIC_: leaking it lets anyone claim jobs and
# attach arbitrary output URLs to them.
RENDER_WORKER_SECRET=

# Which GPU backend to poke: runpod | beam | modal | local
# Jobs are still queued when this is unset — they just wait for a worker.
RENDER_GPU_PROVIDER=runpod

# RunPod Serverless (per-second billing, scales to zero — the default choice)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# RUNPOD_API_BASE=https://api.runpod.ai

# Beam
# BEAM_TOKEN=
# BEAM_ENDPOINT_URL=

# Modal
# MODAL_ENDPOINT_URL=
# MODAL_TOKEN=

# A worker running on your own machine during development
# (WORKER_MODE=serve, then point this at it)
# LOCAL_RENDER_WORKER_URL=http://localhost:8080

# Public URL the GPU container should open. The container is OUTSIDE the VPS
# network, so localhost / internal IPs never work here. Falls back to the
# request's own host when unset.
# RENDER_APP_BASE_URL=https://your-app.example.com

# Storage bucket for rendered output (defaults to product-assets).
# RENDER_OUTPUT_BUCKET=product-assets

# How long finished render output stays downloadable, in hours (default 24).
# Counted from when the job FINISHES, not when it was queued. Everything the
# purge deletes is regenerable — the job payload is frozen, so re-running an
# old job reproduces the same pixels.
#
# Collected by POST /api/render-worker/purge (authenticated with
# RENDER_WORKER_SECRET). Install the hourly cron with scripts/purge-renders.sh;
# the app also sweeps in the background whenever a render is queued, which
# covers a broken cron but only fires when somebody renders.
# RENDER_TTL_HOURS=24

# ── Worker-side tuning (set on the GPU container, not here) ──────────────────
# Listed for reference; see render-worker/README.md and docs/render-gpu-setup.md
#
# RENDER_MAX_JOBS_PER_RUN — ceiling on jobs one warm pod drains before exiting.
#   Only fires when the queue is deeper than the pool of pods, and a drained job
#   is whatever is OLDEST in the queue, not the same product.
#   Images (~2.5 min/job): 5-8 · video (~4-6 min/job): 2-3 · mixed: 3
#
# RENDER_RUN_BUDGET_MS — wall-clock budget for the WHOLE pod. Set it to the
#   provider's execution timeout. Without it, 5 video jobs can overrun a
#   20-minute limit and the pod is killed mid-render, stranding that job until
#   its 15-minute lease expires.
